{
  "name": "@logigator/docs",
  "version": "0.0.0",
  "description": "The authored documentation — markdown in four locales, the screenshots and the page structure — and the changelog parser, shared by the editor's viewer and the website's docs routes",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src",
    "lint:fix": "eslint --config eslint.config.mjs src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
