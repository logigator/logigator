{
  "name": "@logigator/core",
  "version": "0.0.0",
  "description": "Rendering-free circuit code (file format, model, catalog) shared by the editor, the API and migration tooling",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
