<!doctype html>
<html lang="{{preferences.lang}}">
	<head>
		<meta charset="utf-8" />
		<title>{{pageTitle}}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="mask-icon" href="/assets/icons/safari-pinned-tab.svg" color="#27ae60">

		{{#each altPages}}
			<link rel="alternate" hreflang="{{lang}}" href="{{href}}">
		{{/each}}

		<meta name="apple-mobile-web-app-title" content="Logigator">
		<meta name="application-name" content="Logigator">
		<meta name="msapplication-TileColor" content="#2b5797">
		<meta name="theme-color" content="#27ae60">
		<meta name="Description"
			  content="Build and simulate your own logic circuits with Logigator, a simple yet powerful web-based online tool.">
		<meta name="keywords"
			  content="logic circuit, simulator, logic, cad, computer aided design, digital, designer, build, simulate, logic circuit simulator, digital circuit simulator, online">
		<meta property="og:title" content="{{#if pageTitle}}{{pageTitle}}{{else}}Logigator{{/if}}"/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="Logigator"/>
		<meta property="og:url" content="{{canonicalUrl}}"/>
		<meta property="og:image" content="https://logigator.com/assets/social-card.png"/>
		<meta property="og:image:width" content="1200"/>
		<meta property="og:image:height" content="630"/>
		<meta property="og:description"
			  content="Build and simulate your own logic circuits with Logigator, a simple yet powerful web-based online tool."/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:image" content="https://logigator.com/assets/social-card.png"/>
		<meta name="twitter:title" content="{{#if pageTitle}}{{pageTitle}}{{else}}Logigator{{/if}}"/>
		<meta name="twitter:description"
			  content="Build and simulate your own logic circuits with Logigator, a simple yet powerful web-based online tool."/>

		{{styleTag url='/css/layouts/default.css' }}
		{{styleTag url=(concat '/css/views/' @exphbs.view '.css') }}
		{{#if additionalCss}}
			{{styleTag url=additionalCss }}
		{{/if}}

		<script type="text/plain" data-category="analytics">
