{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "logigator-editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "logigator-editor",
      "sourceRoot": "logigator-editor/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/logigator-editor",
            "baseHref": "/editor/",
            "index": "logigator-editor/src/index.html",
            "browser": "logigator-editor/src/main.ts",
            "polyfills": [],
            "tsConfig": "logigator-editor/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "logigator-editor/public"
              }
            ],
            "loader": {
              ".wasm": "file",
              ".svg": "file",
              ".woff2": "file"
            },
            "define": {
              "GIT_COMMIT": "''",
              "BUILD_DATE": "''"
            },
            "styles": ["logigator-editor/src/styles.scss"],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "earcut",
              "@xmldom/xmldom",
              "parse-svg-path"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5MB",
                  "maximumError": "10MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "logigator-editor/src/environments/environment.ts",
                  "with": "logigator-editor/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "logigator-editor:build:production"
            },
            "development": {
              "buildTarget": "logigator-editor:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": ["logigator.test"],
            "prebundle": {
              "exclude": ["@logigator/sim"]
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "logigator-editor/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "logigator-editor/eslint.config.js",
            "lintFilePatterns": [
              "logigator-editor/src/**/*.ts",
              "logigator-editor/src/**/*.html"
            ]
          }
        }
      }
    },
    "logigator-ui": {
      "projectType": "library",
      "root": "logigator-ui",
      "sourceRoot": "logigator-ui/src",
      "prefix": "lg",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "logigator-ui/ng-package.json",
            "tsConfig": "logigator-ui/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "logigator-ui/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "logigator-ui/eslint.config.js",
            "lintFilePatterns": [
              "logigator-ui/src/**/*.ts",
              "logigator-ui/src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
