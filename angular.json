{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "logigator-editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "logigator-editor",
      "sourceRoot": "logigator-editor/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/logigator-editor",
            "baseHref": "/editor/",
            "index": "logigator-editor/src/index.html",
            "browser": "logigator-editor/src/main.ts",
            "polyfills": [],
            "tsConfig": "logigator-editor/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "logigator-editor/public"
              }
            ],
            "loader": {
              ".wasm": "file",
              ".svg": "file",
              ".woff2": "file",
              ".md": "file",
              ".png": "file",
              ".jpg": "file",
              ".jpeg": "file",
              ".webp": "file",
              ".gif": "file",
              ".avif": "file"
            },
            "define": {
              "GIT_COMMIT": "''",
              "BUILD_DATE": "''",
              "AUTOMATION_API": "false",
              "DEBUG_MENU": "false",
              "SHOW_GRID_BORDERS": "false",
              "SHOW_HITBOXES": "false",
              "SHOW_ORIGINS": "false",
              "SHOW_CONNECTION_POINTS": "false"
            },
            "styles": ["logigator-editor/src/styles.scss"],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "earcut",
              "@xmldom/xmldom",
              "parse-svg-path"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5MB",
                  "maximumError": "10MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": true,
                "hidden": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "media",
              "define": {
                "GIT_COMMIT": "''",
                "BUILD_DATE": "''",
                "AUTOMATION_API": "true",
                "DEBUG_MENU": "true",
                "SHOW_GRID_BORDERS": "true",
                "SHOW_HITBOXES": "false",
                "SHOW_ORIGINS": "false",
                "SHOW_CONNECTION_POINTS": "false"
              },
              "fileReplacements": [
                {
                  "replace": "logigator-editor/src/environments/environment.ts",
                  "with": "logigator-editor/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "logigator-editor:build:production"
            },
            "development": {
              "buildTarget": "logigator-editor:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": ["logigator.test"],
            "prebundle": {
              "exclude": ["@logigator/sim"]
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "logigator-editor/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "logigator-editor/eslint.config.mjs",
            "lintFilePatterns": [
              "logigator-editor/src/**/*.ts",
              "logigator-editor/src/**/*.html"
            ]
          }
        }
      }
    },
    "logigator-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "logigator-web",
      "sourceRoot": "logigator-web/src",
      "prefix": "web",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/logigator-web",
            "index": "logigator-web/src/index.html",
            "browser": "logigator-web/src/main.ts",
            "server": "logigator-web/src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "logigator-web/src/server.ts"
            },
            "polyfills": [],
            "tsConfig": "logigator-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "logigator-web/public"
              }
            ],
            "loader": {
              ".svg": "file",
              ".woff2": "file",
              ".png": "file",
              ".jpg": "file",
              ".jpeg": "file",
              ".webp": "file",
              ".avif": "file",
              ".gif": "file",
              ".md": "text"
            },
            "define": {
              "GIT_COMMIT": "''",
              "BUILD_DATE": "''"
            },
            "styles": [
              "logigator-web/src/styles.scss",
              {
                "input": "logigator-web/src/consent/cookieconsent.css",
                "bundleName": "cookieconsent",
                "inject": false
              }
            ],
            "scripts": [
              {
                "input": "node_modules/vanilla-cookieconsent/dist/cookieconsent.umd.js",
                "bundleName": "cookieconsent",
                "inject": false
              },
              {
                "input": "logigator-web/src/consent/cookieconsent-init.js",
                "bundleName": "cookieconsent",
                "inject": false
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": true,
                "hidden": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "media"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "logigator-web:build:production"
            },
            "development": {
              "buildTarget": "logigator-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": ["logigator.test"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "logigator-web/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "logigator-web/eslint.config.mjs",
            "lintFilePatterns": [
              "logigator-web/src/**/*.ts",
              "logigator-web/src/**/*.html"
            ]
          }
        }
      }
    },
    "logigator-ui": {
      "projectType": "library",
      "root": "logigator-ui",
      "sourceRoot": "logigator-ui/src",
      "prefix": "lg",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "logigator-ui/ng-package.json",
            "tsConfig": "logigator-ui/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "logigator-ui/vitest.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "logigator-ui/eslint.config.mjs",
            "lintFilePatterns": [
              "logigator-ui/src/**/*.ts",
              "logigator-ui/src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
