# The origin of the production stack. TLS ends at Cloudflare's edge, which
# reaches this server through the `cloudflared` tunnel, so this listens in plain
# HTTP on the compose network and publishes no port. Every request arrives from
# an edge: the tunnel in production, the `edge` service in a local staging run.

# What a request learned at the edge, handed to an application. Only an edge can
# reach this listener, so its `Cf-Connecting-Ip` is the visitor's address, and
# it overwrites whatever chain a visitor sent along. The scheme is the edge's,
# which is always HTTPS; the API writes no session over a request it believes
# arrived in plain HTTP.
(from_edge) {
	header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
	header_up X-Forwarded-Proto https
}

:8080 {
	# Compression for every upstream at once. A response that already names an
	# encoding is left alone, so an upstream compressing its own output keeps it.
	encode zstd gzip

	# What is the same on every response, from every upstream and from the files
	# served here. `X-Frame-Options` stands beside the CSPs' `frame-ancestors` for
	# browsers without them. The deletion is a directive of its own: a block
	# that deletes is deferred as a whole, and error responses then miss it.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	header -X-Powered-By

	@api path /api /api/*
	handle @api {
		# JSON and PNG only.
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:3000 {
			import from_edge
		}
	}

	# The editor, a static bundle baked into this image. Its address is
	# `/editor`, and `/editor/` is served the same shell rather than redirected:
	# browsers still hold the legacy backend's cached `301` from `/editor` to it,
	# and the editor rewrites the address itself.
	@editor path /editor /editor/*
	handle @editor {
		# The editor's HTML never varies, so its policy is fixed. Report-only until
		# production reports are clean. `'unsafe-eval'` is Pixi's shader code
		# generation, `'wasm-unsafe-eval'` the simulation, `blob:` Pixi's image
		# workers, and the hash the critical-CSS step's `onload` handler.
		header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=' https://u.logigator.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://u.logigator.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		root * /srv/editor
		uri strip_prefix /editor

		# A hashed name is held forever, and a missing one stays an uncached 404:
		# a page from an earlier deploy asking for its old chunk must not be
		# handed the shell under a cache-forever header.
		@hashed path_regexp ^/(?:media/|[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css)(?:\.map)?$)
		handle @hashed {
			@present file
			header @present Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Everything else is a file under a name the next deploy reuses, or one of
		# the editor's own routes, which all get the shell.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	# The API's storage volume: avatars and circuit previews. Every file under it
	# is written once under a name nothing reuses — replacing an asset means a new
	# directory and a new pointer — and serving them here keeps a static read off
	# the application entirely.
	#
	# The edge keeps a file for a year (`CDN-Cache-Control`, RFC 9213, which no
	# browser reads): the API purges a deleted file from it by exact URL. A copy in
	# a browser cannot be purged, so `Cache-Control` keeps an avatar an hour
	# there and a preview a year. Only a file that exists is held, or the edge
	# would keep a 404 for a year; and never under a query string, which makes an
	# address no purge names.
	handle_path /files/* {
		# Uploads are re-encoded; this keeps anything that ever turns out to be
		# HTML or SVG inert when opened directly.
		header Content-Security-Policy "default-src 'none'; sandbox"
		root * /srv/files
		@held {
			file
			query ""
		}
		@queried not query ""
		@preview {
			file
			not path /profile/*
		}
		@avatar {
			file
			path /profile/*
		}
		header @held CDN-Cache-Control "public, max-age=31536000"
		header @queried CDN-Cache-Control "no-store"
		header @preview Cache-Control "public, max-age=31536000, immutable"
		header @avatar Cache-Control "public, max-age=3600"
		file_server
	}

	# The website, at the origin root, including everything the legacy backend's
	# pages used to answer and the redirects from their addresses.
	handle {
		reverse_proxy web:4000 {
			import from_edge
		}
	}

	log {
		output stdout
		level warn
	}
}
