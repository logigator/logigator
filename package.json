{
  "name": "logigator-workspace",
  "version": "0.0.0",
  "description": "Logigator monorepo workspace (editor + @logigator/ui)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "logigator-ui",
    "logigator-editor"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve logigator-editor",
    "build": "ng build logigator-editor --define \"GIT_COMMIT='$(git rev-parse --short HEAD)'\" --define \"BUILD_DATE='$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"",
    "build:ui": "ng build logigator-ui",
    "watch": "ng build logigator-editor --watch --configuration development",
    "test": "ng test logigator-editor",
    "test:ui": "ng test logigator-ui",
    "lint": "ng lint",
    "format": "prettier logigator-editor logigator-ui -c",
    "format:fix": "prettier logigator-editor logigator-ui -lw"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular/cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
