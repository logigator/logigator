{
  "name": "logigator-workspace",
  "version": "0.0.0",
  "description": "Logigator monorepo workspace (editor + api + shared packages)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "logigator-ui",
    "logigator-core",
    "logigator-contract",
    "logigator-editor",
    "logigator-api"
  ],
  "scripts": {
    "ng": "ng",
    "start:editor": "ng serve logigator-editor",
    "start:editor:prod": "ng serve logigator-editor --configuration production",
    "start:api": "yarn build:api && concurrently -k -n rspack,api \"yarn watch:api\" \"node --watch --watch-path=dist/logigator-api --enable-source-maps dist/logigator-api/main.js\"",
    "build": "yarn build:editor && yarn build:api",
    "build:editor": "ng build logigator-editor --define \"GIT_COMMIT='$(git rev-parse --short HEAD)'\" --define \"BUILD_DATE='$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"",
    "build:api": "yarn workspace logigator-api run build",
    "watch:editor": "ng build logigator-editor --watch --configuration development",
    "watch:api": "yarn workspace logigator-api run watch",
    "test": "yarn test:editor && yarn test:ui && yarn test:core && yarn test:contract && yarn test:api",
    "test:editor": "ng test logigator-editor --watch=false",
    "test:ui": "ng test logigator-ui --watch=false",
    "test:core": "yarn workspace @logigator/core run test",
    "test:contract": "yarn workspace @logigator/contract run test",
    "test:api": "yarn workspace logigator-api run test",
    "test:e2e:api": "yarn workspace logigator-api run test:e2e",
    "lint": "yarn lint:editor && yarn lint:ui && yarn lint:core && yarn lint:contract && yarn lint:api",
    "lint:editor": "ng lint logigator-editor",
    "lint:ui": "ng lint logigator-ui",
    "lint:core": "yarn workspace @logigator/core run lint",
    "lint:contract": "yarn workspace @logigator/contract run lint",
    "lint:api": "yarn workspace logigator-api run lint",
    "lint:fix": "yarn lint:editor --fix && yarn lint:ui --fix && yarn lint:core --fix && yarn lint:contract --fix && yarn lint:api --fix",
    "typecheck": "yarn typecheck:core && yarn typecheck:contract && yarn typecheck:api",
    "typecheck:core": "yarn workspace @logigator/core run typecheck",
    "typecheck:contract": "yarn workspace @logigator/contract run typecheck",
    "typecheck:api": "yarn workspace logigator-api run typecheck",
    "format": "prettier . -c",
    "format:fix": "prettier . -lw"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular/cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
