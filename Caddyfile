logigator.test {
	tls internal

	# Compression for every upstream at once. A response that already names an
	# encoding is left alone, so an upstream compressing its own output keeps it.
	encode zstd gzip

	# The API, for the editor and the website alike.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# The editor's address is `/editor`. The dev server is mounted at `/editor/`
	# (its base href) and redirects the bare path there, so it is handed that
	# path rewritten instead. `/editor/` is served as well and never redirected:
	# browsers still hold the legacy backend's cached `301` from `/editor` to it,
	# and the editor rewrites the address itself.
	@editor path /editor /editor/*
	handle @editor {
		rewrite /editor /editor/
		reverse_proxy editor:4200
	}

	# The API's storage volume: avatars and circuit previews. Every file under it
	# is written once under a name nothing reuses — replacing an asset means a new
	# directory and a new pointer — so the URLs are safe to cache forever, and
	# serving them here keeps a static read off the application entirely.
	@storage path /files/*
	handle @storage {
		root * /srv
		uri strip_prefix /files
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# The website, at the origin root, including the icons the editor links to by
	# absolute path.
	handle {
		reverse_proxy web:4200
	}

	log {
		output stdout
		level warn
	}
}
