{
  "name": "logigator-api",
  "version": "0.0.0",
  "description": "Logigator API (NestJS on Fastify)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
  "private": true,
  "scripts": {
    "build": "rspack build",
    "watch": "rspack build --watch",
    "serve": "node --enable-source-maps ../dist/logigator-api/main.js",
    "lint": "eslint --config eslint.config.mjs src test",
    "lint:fix": "eslint --config eslint.config.mjs src test --fix",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "rspack build && node ../dist/logigator-api/migrate.js ./drizzle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/session": "^11.1.2",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@node-rs/bcrypt": "^1.10.8",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.11.0",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.5",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.29",
    "@rspack/cli": "^2.1.9",
    "@rspack/core": "^2.1.9",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "webpack-node-externals": "^3.0.0"
  }
}
