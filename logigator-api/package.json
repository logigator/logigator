{
  "name": "logigator-api",
  "version": "0.0.0",
  "description": "Logigator API (NestJS on Fastify)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logigator/logigator.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rspack build",
    "watch": "rspack build --watch",
    "serve": "node --enable-source-maps ../dist/logigator-api/main.js",
    "lint": "eslint --config eslint.config.mjs src test",
    "lint:fix": "eslint --config eslint.config.mjs src test --fix",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "rspack build && node ../dist/logigator-api/migrate.js",
    "db:renormalize": "rspack build && node ../dist/logigator-api/renormalize.js",
    "db:seed-examples": "rspack build && cd .. && node dist/logigator-api/seed-examples.js",
    "db:moderate": "rspack build && node ../dist/logigator-api/moderate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/session": "^11.1.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@node-rs/bcrypt": "^2.0.0",
    "@prometheus-io/client": "^0.16.1",
    "@standard-schema/spec": "^1.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.7",
    "marked": "^18.1.2",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.3.2",
    "@rspack/cli": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack-node-externals": "^3.0.0"
  }
}
