# Copy to .env to override defaults
# Every variable has a default (see src/config/env.ts).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Postgres and Redis. The defaults name the compose services, so an API running
# in compose needs neither line; override them to reach a database published on
# the host (postgresql://logigator:logigator@localhost:5432/logigator).
DATABASE_URL=postgresql://logigator:logigator@postgres:5432/logigator
DATABASE_POOL_MAX=10
# Boot requires the database to carry exactly the migrations this build ships.
# Turning it off boots a mismatched schema anyway, which is a lever for an
# incident, not a setting to keep off.
# DATABASE_MIGRATION_CHECK=true
REDIS_URL=redis://redis:6379
# Namespace for every Redis key. Development shares one Redis with the legacy
# backend, so the prefix keeps the two from colliding.
REDIS_KEY_PREFIX=lg:

# Where the site is reachable from outside: mail links and the OAuth URLs below
# are built from it, so it has to be an address a browser can open.
PUBLIC_URL=http://logigator.test

# SMTP connection string, credentials included. Unset means mails are rendered
# and logged with their link instead of sent — the development default.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Logigator <noreply@logigator.com>

# Sessions. The secret must be 32 characters or more, and production refuses to
# start on the development default (it is public, in the repository).
# SESSION_SECRET=
SESSION_COOKIE_NAME=lg_sid
SESSION_MAX_AGE_DAYS=30
# How stale a session may get before a response pushes its expiry out again.
# Sliding costs a Redis write and two Set-Cookie headers, and a session pushed
# out to its full lifetime is no shorter for having been pushed an hour ago. `0`
# refreshes on every response, and anything at or above the lifetime is refused.
# SESSION_TOUCH_INTERVAL_MINUTES=60
# Cookies are Secure in production and plain elsewhere unless set here.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Whose X-Forwarded-* headers the API believes, so the rate limiter sees the real
# client address and sessions are written at all. `false` believes none, which is
# right only for a directly reachable API — the process refuses to start on it
# while cookies are Secure, since it serves plain HTTP and something must be
# terminating TLS. Otherwise name the proxy: `uniquelocal` behind Caddy on a
# private network, `loopback` behind one on the same host, a comma-separated list
# of addresses and CIDR ranges to be exact, or `true` where nothing but the proxy
# can reach the process at all.
TRUST_PROXY=false

# Google sign-in. Both unset disables it, and `GET /api/meta` reports that; the
# callback URL must match the one registered with the OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://logigator.test/api/auth/google/callback
# Where the browser returns after a failed OAuth round trip (`?error=` appended).
# OAUTH_RETURN_URL=http://logigator.test/login

# Derived, browser-served files: avatars and circuit previews. Caddy serves this
# directory under /files, and the orphan sweep walks it nightly — an asset no row
# points at is deleted once it is older than the grace window, which is the margin
# that keeps an upload in flight from looking abandoned.
STORAGE_DIR=data/storage
UPLOAD_MAX_BYTES=5242880
STORAGE_SWEEP_GRACE_MINUTES=1440

# Where client-side error reports are mailed. Unset means they are only logged,
# which is the development default — naming a mailbox is the act of deciding to
# read them.
# REPORT_MAIL_TO=ops@logigator.com

# Credentials and one-shot mail tokens.
AUTH_TOKEN_TTL_MINUTES=60
BCRYPT_COST=12
