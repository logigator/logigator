# Copy to .env to override defaults
# Every variable has a default (see src/config/env.ts).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# The largest request body the API reads, for every route. It bounds the body
# after decompression as well as the bytes on the wire, so one number covers
# both. 10 MiB is the ceiling on a saved circuit's JSON — the largest board on
# hand is 5.4 MB, so this is under twice it rather than a comfortable multiple.
# It does not govern uploads: a multipart file meets UPLOAD_MAX_BYTES instead.
REQUEST_MAX_BYTES=10485760

# Postgres and Redis. The defaults name the compose services, so an API running
# in compose needs neither line; override them to reach a database published on
# the host (postgresql://logigator:logigator@localhost:5432/logigator).
DATABASE_URL=postgresql://logigator:logigator@postgres:5432/logigator
DATABASE_POOL_MAX=10
# Boot requires the database to carry exactly the migrations this build ships.
# Turning it off boots a mismatched schema anyway, which is a lever for an
# incident, not a setting to keep off.
# DATABASE_MIGRATION_CHECK=true
REDIS_URL=redis://redis:6379
# Namespace for every Redis key, so the API can share a Redis instance without
# its keys colliding with another application's.
REDIS_KEY_PREFIX=lg:

# Where the site is reachable from outside: mail links and the OAuth URLs below
# are built from it, so it has to be an address a browser can open.
PUBLIC_URL=http://logigator.test

# SMTP connection string, credentials included. Unset means mails are rendered
# and logged with their link instead of sent — the development default.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Logigator <noreply@logigator.com>

# Sessions. The secret must be 32 characters or more, and production refuses to
# start on the development default (it is public, in the repository). To rotate
# it, list the new one first: `new,old`. The first signs, all verify, and a
# returning session is re-signed; drop the old one after SESSION_MAX_AGE_DAYS.
# SESSION_SECRET=
SESSION_COOKIE_NAME=lg_sid
SESSION_MAX_AGE_DAYS=30
# How stale a session may get before a response pushes its expiry out again.
# Sliding costs a Redis write and two Set-Cookie headers, and a session pushed
# out to its full lifetime is no shorter for having been pushed an hour ago. `0`
# refreshes on every response, and anything at or above the lifetime is refused.
# SESSION_TOUCH_INTERVAL_MINUTES=60
# Cookies are Secure in production and plain elsewhere unless set here.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# Whose X-Forwarded-* headers the API believes, so the rate limiter sees the real
# client address and sessions are written at all. `false` believes none, which is
# right only for a directly reachable API — the process refuses to start on it
# while cookies are Secure, since it serves plain HTTP and something must be
# terminating TLS. Otherwise name the proxy: `uniquelocal` behind Caddy on a
# private network, `loopback` behind one on the same host, a comma-separated list
# of addresses and CIDR ranges to be exact, or `true` where nothing but the proxy
# can reach the process at all.
TRUST_PROXY=false

# Google sign-in. Both unset disables it, and `GET /api/meta` reports that; the
# callback URL must match the one registered with the OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://logigator.test/api/auth/google/callback
# Where the browser returns after a failed OAuth round trip (`?error=` appended).
# OAUTH_RETURN_URL=http://logigator.test/login

# Derived, browser-served files: avatars and circuit previews. Caddy serves this
# directory under /files, and the orphan sweep walks it nightly — an asset no row
# points at is deleted once it is older than the grace window, which is the margin
# that keeps an upload in flight from looking abandoned.
STORAGE_DIR=data/storage
# The largest file an upload may carry, per file. This is the limit an avatar
# or a preview render actually meets, so it moves with REQUEST_MAX_BYTES above.
UPLOAD_MAX_BYTES=10485760
STORAGE_SWEEP_GRACE_MINUTES=1440
# How much one account's projects and components may hold, documents and
# previews together. Only growth past it is refused: an account already over
# can still save smaller and delete.
STORAGE_QUOTA_BYTES=20971520

# Where client-side error reports and document reports are mailed. Unset means
# they are only logged (document reports are stored as well), which is the
# development default — naming a mailbox is the act of deciding to read them.
# REPORT_MAIL_TO=ops@logigator.com

# Text analysis of community names and descriptions, through OpenRouter: one
# call per document detects their language, translates them and moderates
# them. Without a key nothing is ever sent — the development default. The model, its fallbacks,
# its token cap, reasoning effort and routing all live in the OpenRouter preset,
# and the key's own daily limit is the spend budget, so none of them is here.
# TEXT_ANALYSIS_ENABLED=false stops new translations and automatic moderation
# alike; reader reports still work, and translations made before keep being
# served.
# TEXT_ANALYSIS_ENABLED=true
# OPENROUTER_API_KEY=
# The preset's slug alone, required with a key; it is sent as @preset/<slug>.
# OPENROUTER_PRESET=
# Whether a severe verdict the model is certain of (illegal content,
# harassment or hate, doxxing) hides the document at once. Off, every verdict
# only opens a report. Needs REPORT_MAIL_TO, which every automatic hide is
# mailed to.
MODERATION_AUTO_HIDE=false
# How often the worker looks for work, and how long a text has to stay
# unchanged before it is claimed, so autosave and typing settle first.
TEXT_ANALYSIS_POLL_SECONDS=30
TEXT_ANALYSIS_DEBOUNCE_SECONDS=120
# Documents claimed per kind per tick.
TEXT_ANALYSIS_BATCH=5
# Calls one owner's documents may cost per UTC day. OpenRouter knows nothing of
# our users, so this is what keeps one account from spending the key's budget.
TEXT_ANALYSIS_DAILY_LIMIT_PER_USER=50

# Credentials and one-shot mail tokens.
AUTH_TOKEN_TTL_MINUTES=60
BCRYPT_COST=12
